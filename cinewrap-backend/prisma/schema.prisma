generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================= NHÓM 1: QUẢN LÝ NGƯỜI DÙNG =================
model User {
  id                Int            @id @default(autoincrement())
  email             String         @unique
  password          String
  full_name         String?
  avatar            String?
  role              String         @default("USER") // ADMIN hoặc USER
  subscription_type String         @default("FREE") // FREE hoặc VIP
  created_at        DateTime       @default(now())
  
  subscriptions     Subscription[]
  reviews           Review[]
  comments          Comment[]
  favorites         Favorite[]
  history           History[]

  // Giám sát hệ thống danh mục (Audit Logs)
  createdCategories Category[]     @relation("CategoryCreator")
  updatedCategories Category[]     @relation("CategoryUpdater")
}

model Subscription {
  id         Int      @id @default(autoincrement())
  user_id    Int
  start_date DateTime @default(now())
  end_date   DateTime
  status     String   @default("ACTIVE") // ACTIVE hoặc EXPIRED
  
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

// ================= NHÓM 2: MASTER DATA (PHIM & DANH MỤC) =================
enum CategoryType {
  GENRE       // Thể loại (Hành động, Hài hước, Kinh dị...)
  THEME       // Chủ đề (Cyberpunk, Cổ trang, Tận thế...)
  MOOD        // Tâm trạng (Chilling, Cảm động, Kịch tính...)
  COLLECTION  // Bộ sưu tập (Vũ trụ Marvel, Phim Tết...)
  HIGHLIGHT   // Tiêu điểm nổi bật (Hot tuần này, Xu hướng...)
}

enum CategoryStatus {
  DRAFT       // Bản nháp (Chỉ Admin/Mod thấy)
  ACTIVE      // Hoạt động (Công khai cho User)
  ARCHIVED    // Lưu trữ (Ẩn công khai nhưng giữ lịch sử)
  DELETED     // Xóa mềm
}

// Thêm Enum cho Phim
enum MovieType {
  SINGLE      // Phim lẻ (chiếu rạp, 1 tập)
  SERIES      // Phim bộ (nhiều tập, có thể có mùa)
}

enum EpisodeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MovieStatus {
  DRAFT       // Nháp, đang nhập liệu
  PENDING     // Chờ duyệt
  PUBLISHED   // Đã xuất bản, hiển thị trên web
  ARCHIVED    // Đã lưu trữ/ẩn
}

model Category {
  id              Int              @id @default(autoincrement())
  type            CategoryType     @default(GENRE)
  slug            String           @unique
  status          CategoryStatus   @default(DRAFT)
  order           Int              @default(0) // Sắp xếp thủ công
  icon            String?
  banner          String?
  color           String?          // Mã màu HEX định dạng giao diện UI
  isFeatured      Boolean          @default(false)
  showInMenu      Boolean          @default(false)
  showInHome      Boolean          @default(false)
  
  // Hỗ trợ đa ngôn ngữ lưu dạng JSON: { "vi": "Hành động", "en": "Action" }
  name            Json
  description     Json?
  displayName     Json?

  // SEO & Discoverability
  metaTitle       String?
  metaDescription String?

  // Lịch sử giám sát (Audit Logs)
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt
  createdBy       Int?             
  updatedBy       Int?             

  creator         User?            @relation("CategoryCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  updater         User?            @relation("CategoryUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  movies          MovieCategory[]
  episodes        EpisodeCategory[]
}

// Bảng trung gian Explicit kết nối Category và Movie
model MovieCategory {
  movieId    Int
  categoryId Int
  movie      Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([movieId, categoryId])
}

// Bảng trung gian Explicit kết nối Category và Episode
model EpisodeCategory {
  episodeId  Int
  categoryId Int
  episode    Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([episodeId, categoryId])
}

model Movie {
  id              Int              @id @default(autoincrement())
  title           String
  original_title  String?          // Tên gốc tiếng Anh/Hàn/Trung...
  slug            String           @unique
  description     String?          @db.Text
  thumbnail       String?
  poster_url      String?
  backdrop_url    String?          // Ảnh ngang làm banner chi tiết phim
  trailer_url     String?
  
  type            MovieType        @default(SINGLE)
  status          MovieStatus      @default(DRAFT)
  
  is_vip          Boolean          @default(false)
  age_rating      String?          // VD: "13+", "18+"
  release_date    DateTime?        // Ngày phát hành chính xác
  release_year    Int?
  duration        Int?             // Thời lượng (phút) - dùng chính cho phim lẻ
  view_count      Int              @default(0)
  average_rating  Float            @default(0)
  
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  categories      MovieCategory[]
  countries       Country[]        // Bảng trung gian tạo tự động bởi Prisma
  
  seasons         Season[]
  episodes        Episode[]
  reviews         Review[]
  comments        Comment[]
  favorites       Favorite[]
}

model Country {
  id     Int      @id @default(autoincrement())
  name   String   @unique
  code   String   @unique // VD: VN, US, KR
  movies Movie[]
}

// ================= NHÓM 3: CẤU TRÚC TẬP PHIM & SERVER =================
model Season {
  id            Int       @id @default(autoincrement())
  movie_id      Int
  season_number Int
  title         String?
  
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  
  movie         Movie     @relation(fields: [movie_id], references: [id], onDelete: Cascade)
  episodes      Episode[]

  @@unique([movie_id, season_number])
}

model Episode {
  id             Int               @id @default(autoincrement())
  movie_id       Int?              // Dành cho phim lẻ không có Season
  season_id      Int?              // Dành cho phim bộ
  episode_number Int
  title          String?
  slug           String?           // Đường dẫn URL tập phim (vd: tap-1, tap-dac-biet)
  description    String?           @db.Text
  duration       Int?              // Thời lượng riêng của tập này (phút)
  status         EpisodeStatus     @default(DRAFT) // Kiểm soát Public/Draft/Archived

  created_at     DateTime          @default(now())
  updated_at     DateTime          @updatedAt

  movie          Movie?            @relation(fields: [movie_id], references: [id], onDelete: Cascade)
  season         Season?           @relation(fields: [season_id], references: [id], onDelete: Cascade)
  servers        VideoServer[]
  history        History[]

  view_count     Int               @default(0)

  categories     EpisodeCategory[]

  // Đảm bảo không trùng số tập trong cùng một Season hoặc cùng một Phim lẻ
  @@unique([season_id, episode_number])
  @@unique([movie_id, episode_number])
}

model VideoServer {
  id          Int      @id @default(autoincrement())
  episode_id  Int
  server_name String   // VD: "Server VIP", "Server Dự Phòng"
  url         String
  quality     String   // VD: "720p", "1080p", "4K"
  
  episode     Episode  @relation(fields: [episode_id], references: [id], onDelete: Cascade)
}

// ================= NHÓM 4: TƯƠNG TÁC NGƯỜI DÙNG =================
model Review {
  id         Int      @id @default(autoincrement())
  user_id    Int
  movie_id   Int
  rating     Int      // 1 đến 5
  content    String?  @db.Text
  created_at DateTime @default(now())
  
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  movie      Movie    @relation(fields: [movie_id], references: [id], onDelete: Cascade)
}

model Comment {
  id         Int       @id @default(autoincrement())
  user_id    Int
  movie_id   Int
  parent_id  Int?      // Trỏ về id của comment cha (nếu là reply)
  content    String    @db.Text
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  movie      Movie     @relation(fields: [movie_id], references: [id], onDelete: Cascade)
  parent     Comment?  @relation("CommentToComment", fields: [parent_id], references: [id])
  replies    Comment[] @relation("CommentToComment")
}

model Favorite {
  id         Int      @id @default(autoincrement())
  user_id    Int
  movie_id   Int
  created_at DateTime @default(now())
  
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  movie      Movie    @relation(fields: [movie_id], references: [id], onDelete: Cascade)

  @@unique([user_id, movie_id]) // Một user chỉ được thích 1 phim 1 lần
}

model History {
  id           Int      @id @default(autoincrement())
  user_id      Int
  episode_id   Int
  watched_time Int      // Lưu số giây đã xem để làm tính năng "Xem tiếp"
  updated_at   DateTime @updatedAt
  
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  episode      Episode  @relation(fields: [episode_id], references: [id], onDelete: Cascade)

  @@unique([user_id, episode_id])
}